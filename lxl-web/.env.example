SVELTE_INSPECTOR_TOGGLE=shift-alt
API_URL=
ID_URL=
AUXD_SECRET=
USE_LOCAL_DISPLAY_JSONLD=false
HOLDING_STATUS_URL=
PUBLIC_MATOMO_URL=
PUBLIC_FJARRLAN_URL=
# searchSite is required for every site except "default".
# matomoId is optional; if missing, Matomo tracking is disabled.
# To test e.g. "swepub" locally, add
# 127.0.0.1 swepub.kb.se.localhost
# to /etc/hosts. Then, after starting the dev server with `npm run dev`,
# - http://localhost:5173/ should return the default (Libris) site
# - http://swepub.kb.se.localhost:5173/ should return the Swepub site.
# SITES='{
#   "default": { "matomoId": 1 },
#   "suecia":  { "searchSite": "https://suecia.kb.se/", "matomoId": 12 },
#   "swepub":  { "searchSite": "https://swepub.kb.se/" }
# }'
SITES=
