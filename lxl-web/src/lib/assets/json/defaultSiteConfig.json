				"previewParams": {
					"_q": "category:\"saogf:Facklitteratur\" yearPublished:-2026 existsImage NOT (instanceCategory:\"https://id.kb.se/term/saobf/Braille\" meta.@type:(VirtualRecord))",
					"_limit": 20,
